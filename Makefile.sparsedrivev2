# ============================================================================
# Makefile.sparsedrivev2  —  SparseDriveV2 (NAVSIM トラック) ターゲット
#   Makefile 末尾の `-include Makefile.sparsedrivev2` で読み込まれる。単体でも
#   `make -f Makefile.sparsedrivev2 sv2-help` で動く。
#
#   典型的な流れ:
#     make sv2-build sv2-up
#     make sv2-weights                       # 重み・anchor → ${HOST_CKPT_DIR}/sparsedrivev2
#     make sv2-data SV2_SPLITS="maps mini"   # まず mini で動作確認
#     make sv2-verify
#     make sv2-data SV2_SPLITS="test"        # navtest
#     make sv2-cache-test sv2-metric-v1 sv2-eval-v1   # PDMS (NAVSIM v1)
# ============================================================================
COMPOSE  ?= docker compose
ENV_FILE ?= .env

SV2_COMPOSE = $(COMPOSE) -f docker-compose.yml -f compose.sparsedrivev2.yml --env-file $(ENV_FILE)
SV2_EXEC    = $(SV2_COMPOSE) exec sparsedrivev2 bash -c
SV2_SPLITS ?= maps mini
SV2_VER    ?= v1
SV2_LOG     = exp/logs/$(1)_$$(date +%Y%m%d_%H%M%S).log

.PHONY: sv2-help sv2-build sv2-up sv2-down sv2-shell sv2-verify sv2-weights sv2-data \
        sv2-cache-test sv2-cache-train sv2-metric-v1 sv2-metric-v2 \
        sv2-metric-train-v1 sv2-metric-train-v2 sv2-eval-v1 sv2-eval-v2 sv2-eval-navhard \
        sv2-train-v1 sv2-train-v2

sv2-help:
	@echo "=== SparseDriveV2 (NAVSIM) ==="
	@echo "  make sv2-build / sv2-up / sv2-down / sv2-shell"
	@echo "  make sv2-weights                     ResNet-34 / anchor / 学習済み ckpt を取得"
	@echo "  make sv2-data SV2_SPLITS=\"maps mini\" (maps mini test navtrain navhard warmup)"
	@echo "  make sv2-verify                      torch / CUDA ops / env / ckpt ロード確認"
	@echo "  make sv2-cache-test sv2-metric-v1 sv2-eval-v1   navtest PDMS"
	@echo "  make sv2-cache-test sv2-metric-v2 sv2-eval-v2   navtest EPDMS"
	@echo "  make sv2-cache-train sv2-metric-train-v1 sv2-train-v1   navtrain 学習"

sv2-build:
	$(SV2_COMPOSE) build sparsedrivev2

sv2-up:
	$(SV2_COMPOSE) up -d sparsedrivev2

sv2-down:
	$(SV2_COMPOSE) stop sparsedrivev2

sv2-shell: sv2-up
	$(SV2_COMPOSE) exec sparsedrivev2 bash

sv2-verify: sv2-up
	$(SV2_EXEC) "python /workspace/tools/verify_env.py"

# ---- ダウンロード (ro マウントを一時的に rw にした使い捨てコンテナで実行) ----
sv2-weights:
	SV2_CKPT_MODE=rw $(SV2_COMPOSE) run --rm --no-deps sparsedrivev2 \
	  bash /workspace/tools/download_weights.sh

sv2-data:
	SV2_DATA_MODE=rw $(SV2_COMPOSE) run --rm --no-deps sparsedrivev2 \
	  bash /workspace/tools/download_navsim_data.sh $(SV2_SPLITS)

# ---- キャッシュ (docs/train_eval.md) --------------------------------------
sv2-cache-test: sv2-up
	$(SV2_EXEC) "sh scripts/cache/run_dataset_caching_navtest.sh"

sv2-cache-train: sv2-up
	$(SV2_EXEC) "sh scripts/cache/run_dataset_caching_navtrain.sh"

sv2-metric-v1: sv2-up
	$(SV2_EXEC) "sh scripts/cache/run_metric_caching_navtest_v1.sh"

sv2-metric-v2: sv2-up
	$(SV2_EXEC) "sh scripts/cache/run_metric_caching_navtest_v2.sh"

sv2-metric-train-v1: sv2-up
	$(SV2_EXEC) "sh scripts/cache/run_metric_caching_navtrain_v1.sh"

sv2-metric-train-v2: sv2-up
	$(SV2_EXEC) "sh scripts/cache/run_metric_caching_navtrain_v2.sh"

# ---- 評価 (ログは ${HOST_DATA_ROOT}/navsim_exp/logs/ に残す) --------------
sv2-eval-v1: sv2-up
	$(SV2_EXEC) "mkdir -p exp/logs && sh scripts/evaluation/run_pdm_score_navtest_v1.sh 2>&1 | tee $(call SV2_LOG,eval_v1)"

sv2-eval-v2: sv2-up
	$(SV2_EXEC) "mkdir -p exp/logs && sh scripts/evaluation/run_pdm_score_navtest_v2.sh 2>&1 | tee $(call SV2_LOG,eval_v2)"

sv2-eval-navhard: sv2-up
	$(SV2_EXEC) "mkdir -p exp/logs && sh scripts/evaluation/run_pdm_score_navhard.sh 2>&1 | tee $(call SV2_LOG,eval_navhard)"

# ---- 学習 -----------------------------------------------------------------
sv2-train-v1: sv2-up
	$(SV2_EXEC) "mkdir -p exp/logs && sh scripts/training/sparsedrive_navsimv1.sh 2>&1 | tee $(call SV2_LOG,train_v1)"

sv2-train-v2: sv2-up
	$(SV2_EXEC) "mkdir -p exp/logs && sh scripts/training/sparsedrive_navsimv2.sh 2>&1 | tee $(call SV2_LOG,train_v2)"
