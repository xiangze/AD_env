# ============================================================
# .env.example
# 環境変数テンプレート。.env にコピーして編集してください。
# cp .env.example .env
# ============================================================

# ホストのデータルート (nuScenes / nuPlan 生データ)
HOST_DATA_ROOT=/mnt/data

# ホストのチェックポイントディレクトリ
HOST_CKPT_DIR=/mnt/ckpts

# GPU 割り当て
UNIAD_GPUS=0,1,2,3,4,5,6,7
ALGE_GPUS=0,1,2,3,4,5,6,7
SIME_GPUS=4,5,6,7

# 分散学習
MASTER_ADDR=localhost
MASTER_PORT=29500

# W&B (任意)
WANDB_API_KEY=
WANDB_PROJECT=uniad-worldengine

# ---- SparseDriveV2 (NAVSIM) ----
# データ: ${HOST_DATA_ROOT}/openscene, 出力: ${HOST_DATA_ROOT}/navsim_exp
# 重み:   ${HOST_CKPT_DIR}/sparsedrivev2
SPARSEV2_GPUS=0
SPARSEV2_CUDA_ARCH=8.6
SPARSEV2_REF=696ef77924eb9e0a4b4047d013a50e9854bfa026
# HuggingFace token (任意; 重み・OpenScene ダウンロードの rate limit 回避)
HF_TOKEN=
